{
  "name": "proofbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "proofbox": "dist/main.js"
  },
  "scripts": {
    "postinstall": "bash scripts/sync-repos.sh",
    "test": "vitest run",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:namespace": "vitest run --config vitest.namespace.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "node scripts/build.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@effect/cli": "0.77.2",
    "@effect/platform": "0.97.2",
    "@effect/platform-node": "0.108.2",
    "@effect/printer": "0.51.0",
    "@effect/printer-ansi": "0.51.0",
    "@namespacelabs/sdk": "1.1.0",
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@effect/vitest": "0.30.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
}
